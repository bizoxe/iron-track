# Dockerized stack, production-like mode (Granian behind Angie, JSON logging).
# Copied by `make setup-env` to .env.docker.
# Replace development credentials/secrets with your own values when needed.
# Configure local HTTPS certificates before starting the stack.
# See README -> Documentation -> Development Workflow -> SSL & Certificates.

# SQLAlchemy engine logs (False/True)
DATABASE_ECHO=False

# SQLAlchemy logging level (30=WARNING, 20=INFO, 10=DEBUG)
SQLALCHEMY_LEVEL=30

# PgBouncer connection URL
DATABASE_URL=postgresql+asyncpg://alfacat:alfacatpwd@pgbouncer:6432/iron_track

# PgBouncer integration toggle
PGBOUNCER_ENABLED=True

# Cache
VALKEY_URL=redis://valkey:6379/0

# Application environment mode (dev/prod)
APP_ENVIRONMENT=prod

# Application root logging level (30=WARNING, 20=INFO, 10=DEBUG)
LOG_LEVEL=30

# Granian configuration
GRANIAN_INTERFACE=asgi
GRANIAN_WORKERS=4
GRANIAN_RUNTIME_THREADS=1
GRANIAN_LOOP=auto
GRANIAN_BACKLOG=2048
GRANIAN_RUNTIME_MODE=auto
GRANIAN_TASK_IMPL=asyncio
GRANIAN_HTTP=auto

# Angie configuration
ALLOWED_ORIGINS_REGEX=https?://(localhost|app\.localhost|www\.yourdomain\.com|admin\.yourdomain\.com)
SERVER_NAME=app.localhost
# SSL certificates
SSL_CERT_PATH=/certs/local-cert.pem
SSL_KEY_PATH=/certs/local-key.pem

# JWT private key for token signing
# Generate with: `make gen-key`
# Required: the app fails fast without it
JWT_PRIVATE_KEY=''